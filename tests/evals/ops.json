{
 "about": "Eval tasks for the operations / SRE library (stage 6). Same method as the other eval files: context coverage (pack vs pack+refs) is an availability proxy, not proof of better answers; rubric and refs share an author. Score real agent answers with --responses DIR.",
 "tasks": [
  {
   "id": "slo-target",
   "pack": "operations",
   "refs": [
    "ops/slo-error-budgets"
   ],
   "prompt": "Our API is new. What availability SLO should we set, and should we aim for 100%?",
   "rubric": [
    {
     "id": "no100",
     "text": "100% is the wrong target",
     "any": [
      "100\\s?%"
     ]
    },
    {
     "id": "ratio",
     "text": "SLI as good events / total events",
     "any": [
      "good.{0,20}total|ratio"
     ]
    },
    {
     "id": "current",
     "text": "don't pick the target from current performance",
     "any": [
      "current performance"
     ]
    },
    {
     "id": "budget",
     "text": "error budget = 1 - SLO",
     "any": [
      "error budget"
     ]
    }
   ]
  },
  {
   "id": "burn-rate",
   "pack": "operations",
   "refs": [
    "ops/slo-error-budgets"
   ],
   "prompt": "How should we alert on our 99.5% SLO without paging on every blip?",
   "rubric": [
    {
     "id": "14",
     "text": "fast-burn page at 14.4x",
     "any": [
      "14\\.4"
     ]
    },
    {
     "id": "multi",
     "text": "multiwindow: long + short window",
     "any": [
      "multi.?window|short window|5\\s?m"
     ]
    },
    {
     "id": "ticket",
     "text": "slow burn becomes a ticket",
     "any": [
      "ticket"
     ]
    },
    {
     "id": "lowtraffic",
     "text": "low traffic: synthetic traffic or combine services",
     "any": [
      "synthetic|low traffic|low-traffic"
     ]
    }
   ]
  },
  {
