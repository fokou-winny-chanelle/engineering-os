  {
   "id": "rename-field",
   "pack": "api-design",
   "refs": [
    "api/evolution"
   ],
   "prompt": "We want to rename `customer_name` to `full_name` in our order API response. Mobile apps v1-v3 are in the stores.",
   "rubric": [
    {
     "id": "breaking",
     "text": "removing/renaming a field is breaking",
     "any": [
      "breaking"
     ]
    },
    {
     "id": "additive",
     "text": "add the new field, keep the old one",
     "any": [
