{
 "about": "Eval tasks for the API design library (stage 4). Same method as the other eval files: context coverage (pack vs pack+refs) is an availability proxy, not proof of better answers; rubric and refs share an author. Score real agent answers with --responses DIR.",
 "tasks": [
  {
   "id": "list-endpoint",
   "pack": "api-design",
   "refs": [
    "api/collections"
   ],
   "prompt": "Add GET /orders to our public API. Clients need to page through thousands of orders and filter by status.",
   "rubric": [
    {
     "id": "cursor",
     "text": "cursor/keyset pagination, opaque cursor",
     "any": [
      "opaque"
     ]
    },
    {
     "id": "object",
     "text": "response is an object with items + next cursor, not a bare array",
     "any": [
      "bare array"
     ]
    },
    {
     "id": "max",
     "text": "page size has a documented maximum; larger values coerced down",
     "any": [
      "maximum"
     ]
    },
    {
     "id": "fewer",
     "text": "clients loop until the cursor is null, not until a short page",
     "any": [
      "short page|fewer"
     ]
    },
    {
     "id": "total",
     "text": "avoid total counts (full scans; hard to remove)",
     "any": [
      "total count"
     ]
    },
    {
     "id": "bind",
     "text": "cursor bound to filters; authorise every page",
     "any": [
      "authoris|authoriz"
     ]
    },
    {
     "id": "tiebreak",
     "text": "stable order with unique tie-breaker",
     "any": [
      "tie-breaker"
     ]
    }
   ]
  },
  {
   "id": "error-format",
   "pack": "api-design",
   "refs": [
    "api/errors-problem-details"
   ],
   "prompt": "Our FastAPI service returns errors in three different shapes. Standardise them.",
   "rubric": [
    {
     "id": "rfc",
     "text": "RFC 9457 problem details",
     "any": [
      "9457"
     ]
    },
    {
     "id": "media",
     "text": "application/problem+json",
     "any": [
      "problem\\+json"
     ]
    },
    {
     "id": "code",
     "text": "stable machine-readable code extension",
     "any": [
      "machine-readable|`code`"
     ]
    },
    {
     "id": "detail",
     "text": "clients must not parse detail",
     "any": [
      "not parse|SHOULD NOT parse"
     ]
    },
    {
     "id": "errors",
     "text": "validation errors as an errors[] list with JSON pointers",
     "any": [
      "pointer"
     ]
    },
    {
     "id": "notrace",
     "text": "no stack traces or SQL",
     "any": [
      "stack trace"
     ]
    },
    {
     "id": "handler",
     "text": "one global exception handler",
     "any": [
      "global handler|exception handler"
     ]
    }
   ]
  },
  {
   "id": "retry-safe-create",
   "pack": "api-design",
   "refs": [
    "api/reliability",
    "architecture/data-consistency"
   ],
   "prompt": "The mobile app sometimes creates duplicate payments when the network times out and the user taps retry. Fix the API.",
   "rubric": [
    {
     "id": "key",
     "text": "Idempotency-Key header per logical operation",
     "any": [
      "Idempotency-Key"
     ]
    },
    {
     "id": "draft",
     "text": "note it is a de-facto convention; IETF draft expired",
     "any": [
      "expired|de-facto"
     ]
    },
    {
     "id": "hash",
     "text": "reject same key with different body",
     "any": [
      "different (request )?hash|different body|mismatch"
     ]
    },
    {
     "id": "inflight",
     "text": "concurrent duplicate gets 409",
     "any": [
      "409"
     ]
    },
    {
     "id": "txn",
     "text": "key stored in the same transaction as the write",
     "any": [
      "same transaction"
     ]
    },
    {
     "id": "ttl",
     "text": "keep keys at least 24 hours",
     "any": [
      "24 hours"
     ]
    },
    {
     "id": "tenant",
     "text": "keys scoped per tenant",
     "any": [
      "tenant"
     ]
    }
   ]
  },
  {
   "id": "lost-update",
   "pack": "api-design",
   "refs": [
    "api/reliability"
   ],
   "prompt": "Two admins editing the same product overwrite each other's changes. Design the API fix.",
   "rubric": [
    {
     "id": "etag",
     "text": "ETag + If-Match",
     "any": [
      "If-Match"
     ]
    },
    {
     "id": "412",
     "text": "412 Precondition Failed on mismatch",
     "any": [
      "412"
     ]
    },
    {
     "id": "428",
     "text": "428 Precondition Required when missing",
     "any": [
      "428"
     ]
    },
    {
     "id": "version",
     "text": "version column in UPDATE ... WHERE version",
     "any": [
      "version"
     ]
    },
    {
     "id": "lastmod",
     "text": "prefer ETags to Last-Modified (1 s resolution)",
     "any": [
      "Last-Modified"
     ]
    }
   ]
  },
  {
   "id": "slow-report",
   "pack": "api-design",
   "refs": [
