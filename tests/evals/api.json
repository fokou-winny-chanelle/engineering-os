     "id": "headers",
     "text": "Deprecation (RFC 9745) and Sunset (RFC 8594) headers",
     "any": [
      "9745"
     ]
    },
    {
     "id": "measure",
     "text": "measure usage by client/app version before removal",
     "any": [
      "usage"
     ]
    },
    {
     "id": "gate",
     "text": "oasdiff breaking-change gate",
     "any": [
      "oasdiff"
     ]
    },
    {
     "id": "mobile",
     "text": "old app versions live for years / minimum supported version",
     "any": [
      "minimum.supported|old app"
     ]
    }
