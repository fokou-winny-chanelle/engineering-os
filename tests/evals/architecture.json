{
 "about": "Eval tasks for the architecture library. eos library eval tests/evals measures tokens and rubric coverage of the loaded context (pack vs pack+refs); with --responses DIR it scores real agent answers (<task>.base.md / <task>.lib.md) with the same rubric. Rubric and refs were written by the same author: treat context coverage as an availability proxy, not proof of better answers.",
 "tasks": [
  {
   "id": "orders-n-plus-one",
   "pack": "performance-scale",
   "refs": [
    "architecture/api-performance",
    "architecture/database-scaling"
   ],
   "prompt": "GET /orders (50 per page) takes 1.8 s; DB CPU is fine. Diagnose and fix.",
   "rubric": [
    {
     "id": "trace",
     "text": "count queries per request / trace first",
     "any": [
      "count(s|ing)? queries|queries per request|trace"
     ]
    },
    {
     "id": "eager",
     "text": "eager-load the relation with the ORM's batch loader",
     "any": [
      "selectinload|prefetch_related|select_related|joinedload|DataLoader"
     ]
    },
    {
     "id": "raise",
     "text": "make lazy loads fail in tests",
     "any": [
      "raiseload|lazy=\\\"raise\\\""
     ]
    },
    {
     "id": "count-test",
     "text": "query-count assertion in tests",
     "any": [
      "assertNumQueries|query-count assertion"
     ]
    },
    {
     "id": "keyset",
     "text": "cursor/keyset pagination instead of OFFSET",
     "any": [
      "keyset|seek method"
     ]
    },
    {
     "id": "composite",
     "text": "composite index matching filter + sort",
     "any": [
      "composite index"
     ]
    },
    {
     "id": "explain",
     "text": "read the plan",
     "any": [
      "EXPLAIN \\(ANALYZE"
     ]
    },
    {
     "id": "pgss",
     "text": "find top queries with pg_stat_statements",
     "any": [
      "pg_stat_statements"
     ]
    }
   ]
  },
