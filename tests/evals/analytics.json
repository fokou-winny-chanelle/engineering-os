     "any": [
      "replica|OLTP"
     ]
    },
    {
     "id": "duckdb",
     "text": "DuckDB or Postgres-first is enough at small scale",
     "any": [
      "DuckDB"
     ]
    },
    {
     "id": "stages",
     "text": "adopt in stages when a real limit appears",
     "any": [
      "[Ss]tage"
     ]
    },
    {
     "id": "cost",
     "text": "cost guardrails before a cloud warehouse",
     "any": [
      "quota|budget|auto-suspend|suspend"
     ]
    }
