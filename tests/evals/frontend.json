{
  "about": "Eval tasks for the frontend & web performance library (stage 7). Same method as the other eval files: context coverage (pack vs pack+refs) is an availability proxy, not proof of better answers; rubric and refs share an author. Score real agent answers with --responses DIR.",
  "tasks": [
    {
      "id": "cache-default",
      "pack": "frontend",
      "refs": [
        "frontend/nextjs-rendering-data"
      ],
      "prompt": "In our Next.js 16 app, is fetch() cached by default? How should we cache a product list that changes hourly?",
      "rubric": [
        {
          "id": "uncached",
          "text": "fetch is not cached by default",
          "any": [
            "not cached|uncached"
          ]
        },
        {
          "id": "usecache",
          "text": "use the 'use cache' directive (Cache Components)",
          "any": [
            "use cache"
          ]
        },
        {
          "id": "life",
          "text": "set a lifetime with cacheLife",
          "any": [
            "cacheLife"
          ]
        },
        {
          "id": "tag",
          "text": "invalidate by tag after writes",
          "any": [
            "cacheTag|revalidateTag|updateTag"
          ]
        }
      ]
    },
    {
      "id": "streaming-status",
      "pack": "frontend",
      "refs": [
        "frontend/nextjs-rendering-data"
      ],
      "prompt": "We stream a product page with Suspense. If the product doesn't exist we call notFound() inside the streamed part. What status code does the client get?",
      "rubric": [
        {
          "id": "200",
          "text": "streaming has already committed a 200",
          "any": [
            "200"
          ]
        },
        {
          "id": "noindex",
          "text": "notFound later only adds a noindex meta",
          "any": [
            "noindex"
          ]
        },
        {
          "id": "before",
          "text": "check existence before the first Suspense boundary / in the shell",
          "any": [
            "before.{0,40}(stream|suspense|shell)|outside.{0,20}suspense"
          ]
        }
      ]
    },
    {
      "id": "server-client",
      "pack": "frontend",
      "refs": [
        "frontend/nextjs-rendering-data"
      ],
      "prompt": "Should our whole page be a Client Component since one button needs onClick?",
      "rubric": [
        {
          "id": "leaf",
          "text": "push 'use client' down to the interactive leaf",
          "any": [
            "lea(f|ves)|push.{0,20}down"
          ]
        },
        {
          "id": "props",
          "text": "pass Server Components as children/props to client ones",
          "any": [
            "children"
          ]
        },
        {
          "id": "serializable",
          "text": "props crossing the boundary must be serializable",
          "any": [
            "serializ"
          ]
        }
      ]
    },
    {
      "id": "server-action-auth",
      "pack": "frontend",
      "refs": [
        "frontend/nextjs-actions-routes"
      ],
      "prompt": "Our Server Action deletes an order. The page already checks the user is logged in. Is that enough?",
      "rubric": [
        {
          "id": "public",
          "text": "a Server Action is a public endpoint",
          "any": [
            "public (HTTP )?endpoint|POST endpoint|reachable"
          ]
        },
        {
          "id": "authz",
          "text": "authenticate and authorize inside the action",
          "any": [
            "inside (the|every) action|in the action|each action"
          ]
        },
        {
          "id": "validate",
          "text": "validate input with a schema",
          "any": [
            "zod|schema|safeParse"
          ]
        }
      ]
    },
    {
      "id": "proxy-auth",
      "pack": "frontend",
      "refs": [
        "frontend/nextjs-actions-routes"
      ],
      "prompt": "Can we do all authorization in proxy.ts (formerly middleware)?",
      "rubric": [
        {
          "id": "no",
          "text": "proxy is not the place for authorization alone",
          "any": [
            "not.{0,40}authori[sz]ation|alone for authori[sz]ation"
          ]
        },
        {
          "id": "cve",
          "text": "CVE-2025-29927 middleware bypass",
          "any": [
            "CVE-2025-29927|29927"
          ]
        },
        {
          "id": "dal",
          "text": "authorize next to the data (data access layer)",
          "any": [
            "data (access )?layer|\\bDAL\\b|close to the data"
          ]
        }
      ]
    },
    {
      "id": "server-state",
      "pack": "frontend",
      "refs": [
        "frontend/state-forms"
      ],
      "prompt": "Should we put API data in Zustand/Redux for our Next.js dashboard?",
      "rubric": [
        {
          "id": "server",
          "text": "server state belongs in a server-state cache (TanStack Query) or Server Components",
          "any": [
            "TanStack|React Query|server state"
          ]
        },
        {
          "id": "url",
          "text": "filters/pagination in the URL",
          "any": [
            "URL|searchParams|nuqs"
          ]
        },
        {
          "id": "local",
          "text": "keep local UI state local",
          "any": [
            "useState|local state"
          ]
        }
      ]
    },
    {
      "id": "shared-schema",
      "pack": "frontend",
      "refs": [
        "frontend/state-forms"
      ],
      "prompt": "Our FastAPI backend uses Pydantic and the Next.js form uses zod. How do we keep validation in sync?",
      "rubric": [
        {
          "id": "openapi",
          "text": "generate from the OpenAPI schema",
          "any": [
            "OpenAPI"
          ]
        },
        {
          "id": "server",
          "text": "the server re-validates; client validation is UX",
          "any": [
            "server.{0,40}(re-?validat|authorit|source of truth)|never trust"
          ]
        },
        {
          "id": "errors",
          "text": "map field errors back to the form",
          "any": [
            "flattenError|fieldErrors|setError|field errors"
          ]
        }
      ]
    },
    {
      "id": "design-tokens",
      "pack": "frontend",
      "refs": [
        "frontend/design-system"
      ],
      "prompt": "How should we structure design tokens and button variants for our component library?",
      "rubric": [
        {
          "id": "tiers",
          "text": "primitive vs semantic tokens",
          "any": [
            "semantic"
          ]
        },
        {
          "id": "variants",
          "text": "typed variants (cva or similar)",
          "any": [
            "cva|variants?"
          ]
        },
        {
          "id": "headless",
          "text": "build on headless/accessible primitives",
          "any": [
            "headless|Radix|React Aria|Base UI"
          ]
        }
      ]
    },
    {
      "id": "a11y-modal",
      "pack": "frontend",
      "refs": [
        "frontend/accessibility"
      ],
      "prompt": "Build an accessible modal dialog. What do we need?",
      "rubric": [
        {
          "id": "focus",
          "text": "move focus in and return it on close",
          "any": [
            "return focus|focus.{0,30}(back|return|restore)"
          ]
        },
        {
          "id": "escape",
          "text": "Escape closes",
          "any": [
            "Escape|Esc"
          ]
        },
        {
          "id": "native",
          "text": "prefer native <dialog> or a tested primitive",
          "any": [
            "<dialog>|showModal|native dialog|primitive"
          ]
        },
        {
          "id": "wcag22",
          "text": "WCAG 2.2 AA: focus not obscured / target size",
          "any": [
            "2\\.4\\.11|2\\.5\\.8|Focus Not Obscured|target size"
          ]
        }
      ]
    },
    {
      "id": "axe-limits",
      "pack": "frontend",
      "refs": [
        "frontend/accessibility"
      ],
      "prompt": "Our axe tests are green. Are we WCAG 2.2 AA compliant?",
      "rubric": [
        {
          "id": "partial",
