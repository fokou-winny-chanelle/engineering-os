      "prompt": "What performance targets and budgets should we set for our web app in Cameroon, and how do we enforce them?",
      "rubric": [
        {
          "id": "thresholds",
          "text": "LCP 2.5 s, INP 200 ms, CLS 0.1 at p75",
          "any": [
            "2\\.5 ?s|2500"
          ]
        },
        {
          "id": "inp",
          "text": "INP replaced FID / measure INP in the field",
          "any": [
            "INP"
          ]
        },
        {
          "id": "lhci",
          "text": "Lighthouse CI assertions in CI",
          "any": [
            "Lighthouse CI|lhci"
          ]
        },
        {
          "id": "field",
          "text": "lab vs field data",
          "any": [
            "field data|RUM|CrUX|useReportWebVitals"
          ]
        }
      ]
