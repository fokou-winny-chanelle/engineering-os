        {
          "id": "nominor",
          "text": "XAF has no decimals",
          "any": [
            "no (minor|decimal)|0 decimals|exponent 0|whole francs"
          ]
        },
        {
          "id": "nnbsp",
          "text": "French uses narrow no-break spaces (tests must not use plain spaces)",
          "any": [
            "U\\+202F|202F|narrow no-break"
          ]
        },
        {
          "id": "tz",
          "text": "show times in Africa/Douala explicitly",
          "any": [
            "Africa/Douala"
          ]
        }
