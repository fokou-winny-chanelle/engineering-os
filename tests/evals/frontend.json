          "any": [
            "57|not conformance|only (a )?part|partial"
          ]
        },
        {
          "id": "manual",
          "text": "manual keyboard + screen reader testing",
          "any": [
            "screen reader|keyboard"
          ]
        },
        {
          "id": "tags",
          "text": "include wcag22aa tags",
          "any": [
            "wcag22aa"
          ]
        }
      ]
