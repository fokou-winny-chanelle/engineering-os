     "id": "decision",
     "text": "frame the decision and cost of errors",
     "any": [
      "decision|cost"
     ]
    },
    {
     "id": "baseline",
     "text": "heuristic/rule baseline first",
     "any": [
      "heuristic|baseline|rule"
     ]
    },
    {
     "id": "metric",
     "text": "metric matches the decision (precision/recall, PR)",
     "any": [
      "precision|recall|PR"
     ]
    },
    {
     "id": "rules-of-ml",
     "text": "Rules of ML cited",
     "any": [
      "Rules of ML|Rule #"
     ]
    }
   ]
  },
