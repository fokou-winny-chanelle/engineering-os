# Generated by `eos scaffold docker-node` for Next.js. Needs `output: "standalone"` in next.config.
# Pattern from https://nextjs.org/docs/app/getting-started/deploying (Docker). Build: docker build -t web {{DIR}}
FROM node:{{NODE_TAG}} AS deps
WORKDIR /app
RUN corepack enable
COPY package.json {{LOCKFILE}} ./
RUN {{PM_INSTALL}}

FROM node:{{NODE_TAG}} AS build
WORKDIR /app
RUN corepack enable
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN {{PM}} run build

FROM node:{{NODE_TAG}}
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
