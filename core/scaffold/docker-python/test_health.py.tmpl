"""Probe contract: liveness never depends on other services; readiness fails (503) when a dependency fails or
hangs, and never leaks the error text. Generated by `eos scaffold docker-python`."""

import asyncio

import pytest

pytest.importorskip("fastapi")  # health.py is the FastAPI version; Flask apps: adapt both files
from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{PY_PKG}} import health


@pytest.fixture
def client(monkeypatch):
    monkeypatch.setattr(health, "CHECKS", {})
    monkeypatch.setattr(health, "CHECK_TIMEOUT", 0.2)
    app = FastAPI()
    app.include_router(health.router)
    return TestClient(app)


async def _ok() -> None:
    return None


async def _broken() -> None:
    raise ConnectionError("db password=hunter2 refused")


async def _hangs() -> None:
    await asyncio.sleep(5)


def test_liveness_ignores_dependencies(client):
    health.CHECKS["db"] = _broken
    assert client.get("/healthz").status_code == 200


def test_ready_when_all_checks_pass(client):
    health.CHECKS["db"] = _ok
    r = client.get("/readyz")
    assert r.status_code == 200 and r.json() == {"db": "ok"}


def test_not_ready_when_a_check_fails_without_leaking_detail(client):
    health.CHECKS.update(db=_ok, cache=_broken)
    r = client.get("/readyz")
    assert r.status_code == 503
    assert r.json() == {"db": "ok", "cache": "fail"}
    assert "hunter2" not in r.text


def test_not_ready_when_a_check_hangs(client):
    health.CHECKS["db"] = _hangs
    r = client.get("/readyz")
    assert r.status_code == 503 and r.json() == {"db": "fail"}
