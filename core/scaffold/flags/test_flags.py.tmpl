"""Flag provider contract: registry defaults, env overrides, stable percentage rollout, safe defaults on
unknown flags. Generated by `eos scaffold flags`."""

import json

import pytest

pytest.importorskip("openfeature")
from openfeature import api

from {{PY_PKG}}.flags import RegistryProvider, env_name, flag_enabled, setup_flags


@pytest.fixture
def registry(tmp_path):
    p = tmp_path / "flags.json"
    p.write_text(
        json.dumps(
            {
                "flags": [
                    {"key": "half", "default": False, "rollout_percent": 50},
                    {"key": "on", "default": True},
                    {"key": "limit", "default": 5},
                ]
            }
        )
    )
    return p


def test_defaults_env_and_unknown(registry):
    setup_flags(RegistryProvider(registry, env={env_name("limit"): "9"}))
    client = api.get_client()
    assert flag_enabled("on") is True
    assert client.get_integer_value("limit", 1) == 9  # env override
    assert flag_enabled("not-registered", default=False) is False  # unknown: the safe default
    assert client.get_boolean_details("not-registered", False).error_code is not None


def test_rollout_is_stable_and_roughly_proportional(registry):
    setup_flags(RegistryProvider(registry, env={}))
    first = [flag_enabled("half", user_id=f"user-{i}") for i in range(1000)]
    again = [flag_enabled("half", user_id=f"user-{i}") for i in range(1000)]
    assert first == again  # the same user always gets the same answer
    assert 400 < sum(first) < 600
    assert flag_enabled("half") is False  # no user: the default, never a random answer
