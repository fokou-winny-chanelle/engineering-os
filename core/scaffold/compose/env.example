# Copy to .env (git-ignored) and adjust. Names only in git; real secrets come from your secret manager.
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# OpenTelemetry (standard env vars; unset = no export)
OTEL_SERVICE_NAME=app
OTEL_EXPORTER_OTLP_ENDPOINT=
# Feature flags: one env var per flag until you adopt a flag service (OpenFeature-compatible)
FEATURE_EXAMPLE=false
