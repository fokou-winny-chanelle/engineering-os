"""Telemetry contract: requests make spans with low-cardinality names, logs carry the same trace ID,
health probes are not traced, secret-looking log fields are redacted. Generated by `eos scaffold otel-python`."""

import io
import json
import logging

import pytest

pytest.importorskip("opentelemetry.sdk")
from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter

from {{PY_PKG}} import telemetry

EXPORTER = InMemorySpanExporter()
_SETUP = False


def _app():
    """A tiny app of whichever framework is installed, instrumented once per test session."""
    global _SETUP
    log = logging.getLogger("demo")
    try:
        from fastapi import FastAPI
        from fastapi.testclient import TestClient

        app = FastAPI()

        @app.get("/items/{item_id}")
        def item(item_id: int):
            log.info("item read", extra={"item_id": item_id, "api_token": "s3cret"})
            return {"id": item_id}

        @app.get("/healthz")
        def healthz():
            return {"status": "ok"}

        make_client = TestClient
    except ImportError:
        flask = pytest.importorskip("flask")
        app = flask.Flask(__name__)

        @app.get("/items/<int:item_id>")
        def item(item_id: int):
            log.info("item read", extra={"item_id": item_id, "api_token": "s3cret"})
            return {"id": item_id}

        @app.get("/healthz")
        def healthz():
            return {"status": "ok"}

        def make_client(a):
            return a.test_client()

    if not _SETUP:
        telemetry.setup_telemetry(None, span_exporter=EXPORTER)
        _SETUP = True
    telemetry._instrument(app)
    return make_client(app)


def test_request_span_log_correlation_and_redaction():
    client = _app()
    buf = io.StringIO()
    telemetry.configure_logging(stream=buf)
    EXPORTER.clear()
    assert client.get("/items/42").status_code == 200
    assert client.get("/healthz").status_code == 200
    servers = [s for s in EXPORTER.get_finished_spans() if s.kind.name == "SERVER"]
    assert len(servers) == 1, [s.name for s in servers]  # /healthz is excluded
    span = servers[0]
    assert span.attributes.get("http.route") in ("/items/{item_id}", "/items/<int:item_id>")
    assert "42" not in span.name  # route template, not the raw path: low cardinality
    line = next(json.loads(x) for x in buf.getvalue().splitlines() if "item read" in x)
    assert line["trace_id"] == format(span.context.trace_id, "032x")
    assert line["item_id"] == 42
    assert line["api_token"] == "[REDACTED]"
