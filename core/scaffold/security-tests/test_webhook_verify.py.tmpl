"""Security tests for webhook verification. Generated by `eos scaffold security-tests`; keep them green.

Copy the pattern for each real webhook route: post a signed request to the route with your test client and
assert the same outcomes (2xx once, 4xx for bad/stale/replayed)."""

import base64
import time

import pytest

from {{PY_PKG}}.webhook_verify import (
    ReplayGuard,
    WebhookVerificationError,
    decode_standard_secret,
    sign_standard,
    verify_hex_hmac,
    verify_standard,
)

KEY = decode_standard_secret("whsec_" + base64.b64encode(b"test-only-signing-key-0123456789").decode())
BODY = b'{"type":"payment.succeeded","data":{"id":"pay_1","amount":5000,"currency":"XAF"}}'


def signed(body=BODY, ts=None, msg_id="msg_1", key=KEY):
    ts = int(time.time()) if ts is None else ts
    return {"webhook-id": msg_id, "webhook-timestamp": str(ts), "webhook-signature": sign_standard(key, msg_id, ts, body)}


def test_valid_signature_accepted():
    assert verify_standard(KEY, signed(), BODY) == "msg_1"


def test_header_names_are_case_insensitive():
    h = {k.title(): v for k, v in signed().items()}
    assert verify_standard(KEY, h, BODY) == "msg_1"


def test_tampered_body_rejected():
    with pytest.raises(WebhookVerificationError):
        verify_standard(KEY, signed(), BODY.replace(b"5000", b"9000"))


def test_wrong_secret_rejected():
    with pytest.raises(WebhookVerificationError):
        verify_standard(KEY, signed(key=b"another-secret-entirely-32bytes!"), BODY)


@pytest.mark.parametrize("skew", [-301, 301, -3600])
def test_stale_or_future_timestamp_rejected(skew):
    with pytest.raises(WebhookVerificationError):
        verify_standard(KEY, signed(ts=int(time.time()) + skew), BODY)


@pytest.mark.parametrize("drop", ["webhook-id", "webhook-timestamp", "webhook-signature"])
def test_missing_header_rejected(drop):
    h = signed()
    del h[drop]
    with pytest.raises(WebhookVerificationError):
        verify_standard(KEY, h, BODY)


def test_rotation_any_listed_signature_matches():
    h = signed()
    h["webhook-signature"] = "v1,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= " + h["webhook-signature"]
    assert verify_standard(KEY, h, BODY) == "msg_1"


def test_parsed_json_is_refused():
    with pytest.raises(TypeError):
        verify_standard(KEY, signed(), {"type": "payment.succeeded"})


def test_replayed_event_processed_once():
    guard = ReplayGuard()
    msg_id = verify_standard(KEY, signed(), BODY)
    assert guard.first_time(msg_id) is True
    assert guard.first_time(verify_standard(KEY, signed(), BODY)) is False


def test_hex_hmac_matches_github_documented_vector():
    # Test vector from GitHub's "Validating webhook deliveries" docs.
    verify_hex_hmac(
        b"It's a Secret to Everybody",
        b"Hello, World!",
        "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17",
    )
    with pytest.raises(WebhookVerificationError):
        verify_hex_hmac(b"It's a Secret to Everybody", b"Hello, World?", "sha256=757107ea" + "0" * 56)
