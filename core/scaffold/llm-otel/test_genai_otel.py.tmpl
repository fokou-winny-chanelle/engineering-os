"""GenAI tracing contract: span names and kinds, gen_ai.* attributes, errors recorded, content capture off by
default, cost only when a dated price is configured. Generated by `eos scaffold llm-otel`."""

import pytest

pytest.importorskip("opentelemetry.sdk")
from opentelemetry.sdk.trace import TracerProvider
from opentelemetry.sdk.trace.export import SimpleSpanProcessor
from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
from opentelemetry.trace import SpanKind, StatusCode

from {{PY_PKG}} import genai_otel

EXPORTER = InMemorySpanExporter()
PROVIDER = TracerProvider()
PROVIDER.add_span_processor(SimpleSpanProcessor(EXPORTER))
TRACER = PROVIDER.get_tracer("test")


class _Usage:
    input_tokens, output_tokens = 1200, 80

    class input_tokens_details:  # noqa: N801 - mirrors the SDK attribute name
        cached_tokens = 1024


class _Resp:
    model, status, usage = "gpt-6-luna-2026-09-01", "completed", _Usage()


def setup_function():
    EXPORTER.clear()


def test_model_call_span():
    with genai_otel.llm_span("chat", "openai", "gpt-6-luna", prompt_name="support-answer", prompt_version=3,
                             max_tokens=600, tracer=TRACER) as span:  # fmt: skip
        genai_otel.record_openai_response(span, _Resp())
        genai_otel.record_content(span, "gen_ai.input.messages", "Bonjour, je suis Paul, 677 00 00 00")
    (s,) = EXPORTER.get_finished_spans()
    assert s.name == "chat gpt-6-luna" and s.kind == SpanKind.CLIENT
    a = s.attributes
    assert a["gen_ai.provider.name"] == "openai" and a["gen_ai.prompt.version"] == "3"
    assert a["gen_ai.usage.input_tokens"] == 1200 and a["gen_ai.usage.cache_read.input_tokens"] == 1024
    assert a["gen_ai.response.model"] == "gpt-6-luna-2026-09-01"
    assert "gen_ai.input.messages" not in a  # content capture is opt-in
    assert "app.genai.cost_estimate" not in a  # no price configured


def test_errors_and_cost(monkeypatch):
    monkeypatch.setitem(genai_otel.PRICES, "m", {"input": 1.0, "output": 2.0, "cached_input": 0.1, "checked": "x"})
    assert genai_otel.estimate_cost("m", 1_000_000, 1_000_000, 500_000) == pytest.approx(0.5 + 0.05 + 2.0)
    with pytest.raises(TimeoutError), genai_otel.tool_span("lookup_order", tracer=TRACER):
        raise TimeoutError("slow")
    (s,) = EXPORTER.get_finished_spans()
    assert s.name == "execute_tool lookup_order" and s.status.status_code == StatusCode.ERROR
    assert s.attributes["error.type"] == "TimeoutError"
