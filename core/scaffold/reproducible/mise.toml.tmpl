# Toolchain pins for this repo (mise: https://mise.jdx.dev). Generated by `eos scaffold reproducible`.
# First time:  mise install && mise lock      (commit mise.toml + mise.lock)
# Afterwards:  mise install --locked          (CI: jdx/mise-action adds --locked when mise.lock exists)
# mise pins runtimes and CLIs, not system libraries or app dependencies (keep your lockfiles too).
[settings]
lockfile = true

[tools]
{{MISE_TOOLS}}
