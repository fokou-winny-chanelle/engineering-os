# Copy to ~/.config/engineering-os/secrets.env (bootstrap does this; file is chmod 600 and OUTSIDE git).
# Names only here. Never commit real values. Prefer least-privilege, short-lived tokens; rotate every 90 days.
GITHUB_MCP_PAT=
CONTEXT7_API_KEY=
POSTMAN_API_KEY=
# Optional: only for `eos models --usage` (read-only spend check). Cline keeps its own copy in its settings.
OPENROUTER_API_KEY=
# Postgres MCP (profiles api/debug). DEV/LOCAL ONLY, read-only role from mcp/postgres-readonly-role.sql.
# The guard refuses hosts outside localhost/127.0.0.1/::1/host.docker.internal/postgres/db/database/pg.
POSTGRES_MCP_URL=
# Optional: more dev hosts (comma-separated, wildcards ok), e.g. staging-db,*.dev.internal
EOS_MCP_PG_ALLOWED_HOSTS=
# Optional: per-statement limit forced on every session (default 30s)
EOS_MCP_PG_STATEMENT_TIMEOUT=
# Optional, Playwright MCP (profiles design/debug-ui): extra origins (';'-separated) and 1 to see the browser
EOS_MCP_BROWSER_ORIGINS=
EOS_MCP_BROWSER_HEADED=
# Optional: 1 = Cline auto-approves only the read-only `safe_tools` of the guarded servers (default: every call asks)
EOS_MCP_CLINE_AUTO_APPROVE_SAFE=
